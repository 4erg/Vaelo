#!/usr/bin/env php
<?php

declare(strict_types=1);

const BASE_PATH = __DIR__;

$command = $argv[1] ?? 'list';

function loadEnv(): array
{
    $envPath = BASE_PATH . DIRECTORY_SEPARATOR . '.env';
    if (!is_file($envPath)) {
        return [];
    }

    $env = [];
    foreach (file($envPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#') || !str_contains($line, '=')) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $env[trim($key)] = trim($value, " \t\n\r\0\x0B\"'");
    }

    return $env;
}

function dbConfig(): array
{
    $env = loadEnv();

    return [
        'host' => $env['DB_HOST'] ?? '127.0.0.1',
        'port' => (int) ($env['DB_PORT'] ?? 3306),
        'database' => $env['DB_NAME'] ?? 'vaelo',
        'username' => $env['DB_USER'] ?? 'root',
        'password' => $env['DB_PASSWORD'] ?? '',
    ];
}

function pdo(?string $database = null): PDO
{
    $config = dbConfig();
    $dbPart = $database === null ? '' : ';dbname=' . $database;
    $dsn = sprintf('mysql:host=%s;port=%d%s;charset=utf8mb4', $config['host'], $config['port'], $dbPart);

    return new PDO($dsn, $config['username'], $config['password'], [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
}

function runStatements(PDO $connection, array $statements): void
{
    foreach ($statements as $statement) {
        $statement = trim((string) $statement);
        if ($statement === '') {
            continue;
        }

        $connection->exec($statement);
    }
}

function migrate(): void
{
    $migrationPath = BASE_PATH . DIRECTORY_SEPARATOR . 'database' . DIRECTORY_SEPARATOR . 'migrations';
    $files = glob($migrationPath . DIRECTORY_SEPARATOR . '*.php') ?: [];
    sort($files);

    if ($files === []) {
        echo "Nothing to migrate.\n";
        return;
    }

    $rootConnection = pdo();
    $db = dbConfig()['database'];
    $rootConnection->exec("CREATE DATABASE IF NOT EXISTS `{$db}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");

    $connection = pdo($db);
    $connection->exec(
        "CREATE TABLE IF NOT EXISTS migrations (
            id INT AUTO_INCREMENT PRIMARY KEY,
            migration VARCHAR(255) NOT NULL UNIQUE,
            batch INT NOT NULL,
            created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
        )"
    );

    foreach ($files as $file) {
        $migration = pathinfo($file, PATHINFO_FILENAME);
        $exists = $connection
            ->prepare('SELECT COUNT(*) FROM migrations WHERE migration = ?');
        $exists->execute([$migration]);

        if ((int) $exists->fetchColumn() > 0) {
            echo "Already migrated: {$migration}\n";
            continue;
        }

        $statements = require $file;
        if (!is_array($statements)) {
            throw new RuntimeException("La migracion debe retornar un array: {$file}");
        }

        runStatements($connection, $statements);
        $connection
            ->prepare('INSERT INTO migrations (migration, batch) VALUES (?, 1)')
            ->execute([$migration]);

        echo "Migrated: {$migration}\n";
    }
}

function seed(): void
{
    $db = dbConfig()['database'];
    $connection = pdo($db);
    $databaseSeeder = BASE_PATH . DIRECTORY_SEPARATOR . 'database' . DIRECTORY_SEPARATOR . 'seeders' . DIRECTORY_SEPARATOR . 'DatabaseSeeder.php';

    if (!is_file($databaseSeeder)) {
        throw new RuntimeException("No existe DatabaseSeeder.php");
    }

    $seeders = require $databaseSeeder;
    if (!is_array($seeders)) {
        throw new RuntimeException('DatabaseSeeder.php debe retornar un array de seeders.');
    }

    foreach ($seeders as $seeder) {
        $statements = require $seeder;
        if (!is_array($statements)) {
            throw new RuntimeException("El seeder debe retornar un array: {$seeder}");
        }

        runStatements($connection, $statements);
        echo 'Seeded: ' . pathinfo($seeder, PATHINFO_FILENAME) . "\n";
    }
}

try {
    match ($command) {
        'migrate' => migrate(),
        'db:seed' => seed(),
        'migrate:fresh' => (function (): void {
            $db = dbConfig()['database'];
            pdo()->exec("DROP DATABASE IF EXISTS `{$db}`");
            migrate();
            seed();
        })(),
        default => print "VAELO artisan commands:\n  php artisan migrate\n  php artisan db:seed\n  php artisan migrate:fresh\n",
    };
} catch (Throwable $error) {
    fwrite(STDERR, "Error: {$error->getMessage()}\n");
    exit(1);
}
